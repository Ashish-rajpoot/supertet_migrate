# Secret used to sign account/login tokens (JWT). Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# MongoDB connection string
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/supertet-prep

# Or MongoDB Atlas (cloud, free tier):
# Replace <db_password> with your Atlas database user password:
# MONGODB_URI=mongodb+srv://<user>:<db_password>@cluster0.3abiu.mongodb.net/supertet-prep?retryWrites=true&w=majority&appName=Cluster0

# Comma-separated emails promoted to admin the first time they sign in.
# ADMIN_EMAILS=you@example.com

# Default admin account created automatically on first start.
# DEV ONLY - change (or set ADMIN_EMAIL empty) before going to production.
# ADMIN_EMAIL=admin@gmail.com
# ADMIN_PASSWORD=admin@123

# Google Sign-In client id. Leave empty to hide the Google button.
# GOOGLE_CLIENT_ID=


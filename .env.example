# Secret used to sign account/login tokens (JWT). Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# MongoDB connection string
# Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/supertet-prep

# Or MongoDB Atlas (cloud, free tier):
# Replace <db_password> with your Atlas database user password:
# MONGODB_URI=mongodb+srv://<user>:<db_password>@cluster0.3abiu.mongodb.net/supertet-prep?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=mongodb+srv://ashish142:ashish142@cluster0.3abiu.mongodb.net/supertet-prep?retryWrites=true&w=majority&appName=Cluster0

# Comma-separated emails promoted to admin the first time they sign in.
# ADMIN_EMAILS=you@example.com

# Default admin account created automatically on first start.
# DEV ONLY - change (or set ADMIN_EMAIL empty) before going to production.
# ADMIN_EMAIL=admin@gmail.com
# ADMIN_PASSWORD=admin@123

# Google Sign-In. Both names must hold the SAME client id:
#   GOOGLE_CLIENT_ID             - the API rejects tokens minted for another app
#   NEXT_PUBLIC_GOOGLE_CLIENT_ID - the Google button in the login dialog
# Leave both empty to hide the Google button.
#
# In Google Cloud Console: APIs & Services > Credentials > Create credentials >
# OAuth client ID > Web application, then add "Authorized JavaScript origins":
#   http://localhost:3000
#   https://your-production-domain
# No redirect URI is needed - the app uses the Identity Services ID-token flow,
# so the client SECRET is never used and must never be exposed to the browser.
#
# GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

